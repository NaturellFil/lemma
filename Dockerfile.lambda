# Lemma Lambda — CONTAINER IMAGE packaging (TBHM big-tools edition).
#
# A zip-packaged Lambda is capped at 250 MB unzipped, which cannot hold the full
# Bug Hunter's Methodology (Jhaddix) recon stack + wordlists. A container image
# gets 10 GB, so we bake the whole recon toolchain in. (nuclei-templates are
# fetched to /tmp at runtime by the nuclei wrapper, not baked.)
#
# Build strategy (3 stages so the final image carries the tools tree exactly
# once — no duplicated /go/bin layer):
#   stage 1 (gobuild)  : `go install` the Go tool ecosystem + compile massdns
#   stage 2 (assemble) : distribute go binaries + download prebuilt/Rust tools,
#                        wordlists, resolvers, gf-patterns into /build/tools
#   stage 3 (final)    : python:slim + Lambda Web Adapter; COPY the finished
#                        tools tree once, then pip-install the app + python tools
#
# The AWS Lambda Web Adapter (in /opt/extensions) turns the FastAPI response-
# streaming server into a Lambda handler — it polls the Runtime API and proxies
# to local uvicorn; no Runtime Interface Client needed.

# =========================================================================
# stage 1: build the Go tool ecosystem + massdns
# =========================================================================
FROM golang:1.24-bookworm AS gobuild

RUN apt-get update && apt-get install -y --no-install-recommends \
        git gcc make libpcap-dev ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# GOTOOLCHAIN=auto lets `go install` fetch a newer toolchain if a tool's go.mod
# requires one (several PD tools now need >= go 1.24).
ENV GOFLAGS=-buildvcs=false \
    GOBIN=/go/bin \
    GOTOOLCHAIN=auto

# Static (CGO-free) tools — PD suite, tomnomnom utils, crawlers, community tools.
ENV CGO_ENABLED=0
RUN set -eux; \
    for mod in \
        github.com/projectdiscovery/subfinder/v2/cmd/subfinder@latest \
        github.com/projectdiscovery/dnsx/cmd/dnsx@latest \
        github.com/projectdiscovery/httpx/cmd/httpx@latest \
        github.com/projectdiscovery/katana/cmd/katana@latest \
        github.com/projectdiscovery/nuclei/v3/cmd/nuclei@latest \
        github.com/projectdiscovery/tlsx/cmd/tlsx@latest \
        github.com/projectdiscovery/asnmap/cmd/asnmap@latest \
        github.com/projectdiscovery/cdncheck/cmd/cdncheck@latest \
        github.com/projectdiscovery/mapcidr/cmd/mapcidr@latest \
        github.com/projectdiscovery/alterx/cmd/alterx@latest \
        github.com/projectdiscovery/shuffledns/cmd/shuffledns@latest \
        github.com/projectdiscovery/interactsh/cmd/interactsh-client@latest \
        github.com/tomnomnom/assetfinder@latest \
        github.com/tomnomnom/anew@latest \
        github.com/tomnomnom/unfurl@latest \
        github.com/tomnomnom/qsreplace@latest \
        github.com/tomnomnom/httprobe@latest \
        github.com/tomnomnom/waybackurls@latest \
        github.com/tomnomnom/gf@latest \
        github.com/hakluke/hakrawler@latest \
        github.com/jaeles-project/gospider@latest \
        github.com/lc/subjs@latest \
        github.com/lc/gau/v2/cmd/gau@latest \
        github.com/gwen001/github-subdomains@latest \
        github.com/d3mondev/puredns/v2@latest \
        github.com/hahwul/dalfox/v2@latest \
        github.com/ffuf/ffuf/v2@latest \
    ; do echo ">> go install $mod"; go install -v "$mod"; done

# CGO tools — naabu needs libpcap (connect-scan still links it).
RUN CGO_ENABLED=1 go install -v github.com/projectdiscovery/naabu/v2/cmd/naabu@latest

# massdns (C) — required by puredns / shuffledns
RUN git clone --depth 1 https://github.com/blechschmidt/massdns /tmp/massdns \
    && make -C /tmp/massdns \
    && cp /tmp/massdns/bin/massdns /go/bin/massdns

# =========================================================================
# stage 2: assemble the final tools tree (intermediate, discarded)
# =========================================================================
FROM debian:bookworm-slim AS assemble

RUN apt-get update && apt-get install -y --no-install-recommends \
        curl wget unzip git tar ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ARG TOOL_ARCH=amd64
WORKDIR /build

COPY tools/ /build/tools/
COPY --from=gobuild /go/bin/ /build/gobin/

# Distribute go binaries + download prebuilt tools, wordlists, resolvers,
# gf-patterns; write tool_requirements.txt (boto3). /build/gobin stays in this
# throwaway stage and is never copied into the final image.
RUN GOBIN_SRC=/build/gobin /build/tools/install_tools_container.sh "$TOOL_ARCH" /build/tools /build \
    && rm -f /build/tools/install_tools.sh /build/tools/install_tools_container.sh

# =========================================================================
# stage 3: final Lambda image
# =========================================================================
FROM public.ecr.aws/docker/library/python:3.12-slim

# Lambda Web Adapter (response streaming bridge)
COPY --from=public.ecr.aws/awsguru/aws-lambda-adapter:0.9.1 /lambda-adapter /opt/extensions/lambda-adapter

# Runtime deps only: curl (getwl), git (paramspider pip), libpcap (naabu).
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl git ca-certificates libpcap0.8 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /var/task

# The finished tools tree — copied exactly once (no duplicated go-bin layer).
COPY --from=assemble /build/tools /var/task/tools
COPY --from=assemble /build/tool_requirements.txt /var/task/tool_requirements.txt

# Python deps for the FastAPI app + boto3 (requirements.txt ends with
# "-r tool_requirements.txt").
COPY app/requirements.txt /var/task/requirements.txt
RUN pip install --no-cache-dir -r /var/task/requirements.txt

# Python recon tools (console scripts land in the runtime python env).
RUN pip install --no-cache-dir arjun dnsgen uro \
    && pip install --no-cache-dir "git+https://github.com/devanshbatham/paramspider.git"

# App code (main.py, static/, run.sh). Does not clobber tools/.
COPY app/ /var/task/

ENV HOME=/tmp \
    PORT=8000 \
    AWS_LWA_INVOKE_MODE=response_stream \
    GF_PATH=/var/task/tools/gf-patterns \
    PATH="/var/task/tools/bin:${PATH}"

CMD ["python", "-m", "uvicorn", "--host", "0.0.0.0", "--port", "8000", "main:app"]
