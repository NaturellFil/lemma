#!/bin/bash
# puredns — fast subdomain bruteforce/resolve via massdns.
# Read-only FS => HOME/state to /tmp. Defaults the massdns binary path and the
# baked resolvers list unless the caller overrode them.
export HOME=/tmp
DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
RES="$DIR/config/resolvers.txt"

have_res=0 have_bin=0
for a in "$@"; do
    case "$a" in
        -r|--resolvers) have_res=1 ;;
        -b|--bin) have_bin=1 ;;
    esac
done

EXTRA=()
[ "$have_bin" -eq 0 ] && EXTRA+=(--bin "$DIR/bin/massdns")
[ "$have_res" -eq 0 ] && [ -s "$RES" ] && EXTRA+=(-r "$RES")

exec "$DIR/bin/puredns" "${EXTRA[@]}" "$@"
